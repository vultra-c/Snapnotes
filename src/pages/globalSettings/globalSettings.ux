<template>
  <div class="page" style="flex-direction: column;">

    <list class="list">
      <!-- 显示设置分区 -->
      <list-item class="item" style="padding: 7px 16px; height: 50px;" type="tip">
        <text class="section-title" static>显示设置</text>
      </list-item>
      <list-item class="item" type="item">
        <div class="item-content">
          <text class="itemtext" static>字号大小</text>
          <text class="itemtext2" static>全局阅读字号</text>
        </div>
        <div style="flex-direction: row; align-items: center;">
          <img static src="/common/images/pre.png" @click="adjustFontSize(-1)" style="width: 40px; height: 40px;" />
          <text style="font-size: 28px; font-weight: bold; color: white; width: 70px; text-align: center;">{{fontSizeValue}}px</text>
          <img static src="/common/images/next.png" @click="adjustFontSize(1)" style="width: 40px; height: 40px;" />
        </div>
      </list-item>
      <list-item class="item" @click="toggleKeepScreenOn" type="item">
        <div class="item-content">
          <text class="itemtext" static>常亮显示</text>
          <text class="itemtext2" static>保持屏幕常亮</text>
        </div>
        <img src="{{keepScreenOn ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" class="switch" />
      </list-item>
      <list-item class="item" @click="toggleTimeFormat" type="item">
        <div class="item-content">
          <text class="itemtext" static>时间格式</text>
          <text class="itemtext2" static>12小时/24小时制</text>
        </div>
        <text style="font-size: 28px; font-weight: bold; color: rgba(255,255,255,0.6);">{{timeFormat === '12h' ? '12小时' : '24小时'}}</text>
      </list-item>
      <list-item class="item" @click="toggleKeyboardVibrate" type="item">
        <div class="item-content">
          <text class="itemtext" static>键盘震动</text>
          <text class="itemtext2" static>输入法点击震动</text>
        </div>
        <text style="font-size: 28px; font-weight: bold; color: rgba(255,255,255,0.6);">{{keyboardVibrateMode === 'short' ? '短震' : (keyboardVibrateMode === 'long' ? '长震' : '关闭')}}</text>
      </list-item>

      <!-- 数据管理分区 -->
      <list-item class="item" style="padding: 7px 16px; height: 50px;" type="tip">
        <text class="section-title" static>数据管理</text>
      </list-item>
      <list-item class="item" type="item">
        <div class="item-content">
          <text class="itemtext" static>剩余内存</text>
          <text class="itemtext2" static>设备可用存储</text>
        </div>
        <text style="font-size: 28px; font-weight: bold; color: rgba(255,255,255,0.6); lines: 1; text-overflow: ellipsis;">{{availableStorage}}</text>
      </list-item>
      <list-item class="item" type="item">
        <div class="item-content">
          <text class="itemtext" static>考点总数</text>
          <text class="itemtext2" static>已存储考点数量</text>
        </div>
        <div style="flex-direction: column; align-items: flex-end;">
          <text style="font-size: 28px; font-weight: bold; color: rgba(255,255,255,0.6);">{{builtinCount}} 篇（不含导入）</text>
          <text style="font-size: 28px; font-weight: bold; color: rgba(255,255,255,0.6);">{{totalCount}} 篇（含导入）</text>
        </div>
      </list-item>
      <list-item class="item" @click="goDeleteAll" type="item">
        <div class="item-content">
          <text class="itemtext" static>一键删除</text>
          <text class="itemtext2" static>删除所有考点</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
      <list-item class="item" @click="goImport" type="item">
        <div class="item-content">
          <text class="itemtext" static>知识点管理</text>
          <text class="itemtext2" static>导入/删除知识点</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>

      <!-- 存储管理分区 -->
      <list-item class="item" style="padding: 7px 16px; height: 50px;" type="tip">
        <text class="section-title" static>存储管理</text>
      </list-item>
      <list-item class="item" type="item">
        <div class="item-content">
          <text class="itemtext" static>占用存储</text>
          <text class="itemtext2" static>考点内容占用大小</text>
        </div>
        <text style="font-size: 28px; font-weight: bold; color: rgba(255,255,255,0.6);">{{contentStorageSize}}</text>
      </list-item>
      <list-item class="item" @click="clearCache" type="item">
        <div class="item-content">
          <text class="itemtext" static>清理缓存</text>
          <text class="itemtext2" static>清除内存缓存</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>

      <!-- 传输记录分区 -->
      <list-item class="item" style="padding: 7px 16px; height: 50px;" type="tip">
        <text class="section-title" static>传输记录</text>
      </list-item>
      <list-item class="item" if="{{transferRecords.length == 0}}" type="item">
        <div class="item-content">
          <text class="itemtext2" static>暂无传输记录</text>
        </div>
      </list-item>
      <list-item class="item" for="{{transferRecords}}" tid="id" type="record">
        <div class="item-content">
          <text class="itemtext" static>{{$item.name}}</text>
          <text class="itemtext2" static>{{$item.time}}</text>
        </div>
      </list-item>

      <!-- 应用信息底栏 -->
      <list-item style="width: 100%; height: 260px; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 24px;" type="footer">
        <img static src="/common/images/icon.png" style="width: 64px; height: 64px; border-radius: 14px;" />
        <text static style="font-size: 26px; font-weight: bold; color: white; text-align: center; margin-top: 10px;">{{appName}}</text>
        <text static style="font-size: 22px; font-weight: bold; color: rgba(255,255,255,0.4); text-align: center; margin-top: 6px;">版本 {{versionName}}</text>
        <text static style="font-size: 20px; font-weight: bold; color: rgba(255,255,255,0.3); text-align: center; margin-top: 8px;">开发：{{developer}}</text>
      </list-item>
    </list>

    <!-- 顶部栏 -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text static style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">全局设置</text>

  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import device from '@system.device'
import app from '@system.app'
import prompt from '@system.prompt'
import dataManager from '../../common/utils/dataManager.js'
import appState from '../../common/utils/appState.js'
import { onTimeChange, offTimeChange } from '../../common/clock.js'

export default {
  private: {
    nowTime: '00:00',
    __unsubClock: null,
    fontSizeValue: 26,
    keepScreenOn: false,
    timeFormat: '24h',
    keyboardVibrateMode: '',
    availableStorage: '加载中...',
    builtinCount: '加载中...',
    totalCount: '加载中...',
    contentStorageSize: '加载中...',
    transferRecords: [],
    versionName: '1.0.1',
    appName: '闪念小抄',
    developer: 'Vultra 和 文华逸洋'
  },

  onInit() {
    this.__unsubClock = onTimeChange((t) => {
      if (this.$valid) {
        this.nowTime = this._fmtClock(t)
      }
    })
    this.loadVersion()
    this.loadAllSettings()
    this.loadStorageInfo()
  },

  onShow() {
    if (!this.$valid) return
    this.loadAllSettings()
    this.loadStorageInfo()
  },

  onDestroy() {
    if (this.__unsubClock) {
      offTimeChange(this.__unsubClock)
      this.__unsubClock = null
    }
  },

  _fmtClock(t) {
    if (this.timeFormat === '12h') {
      const parts = t.split(':')
      let h = parseInt(parts[0], 10) || 0
      const m = parts[1] || '00'
      const ampm = h >= 12 ? '下午' : '上午'
      h = h % 12 || 12
      return ampm + ' ' + h + ':' + m
    }
    return t
  },

  loadVersion() {
    try {
      const info = app.getInfo()
      if (info) {
        if (info.versionName) {
          this.versionName = info.versionName
        }
        if (info.name) {
          this.appName = info.name
        }
      }
    } catch (e) {
      // 使用默认值
    }
  },

  loadAllSettings() {
    storage.get({
      key: 'KD_FONT_SIZE',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.fontSizeValue = parseInt(data)
        }
      },
      fail: () => {
        if (!this.$valid) return
        this.fontSizeValue = 26
      }
    })
    storage.get({
      key: 'KD_KEEP_SCREEN_ON',
      success: (data) => {
        if (!this.$valid) return
        this.keepScreenOn = data === 'true'
      },
      fail: () => {
        if (!this.$valid) return
        this.keepScreenOn = false
      }
    })
    storage.get({
      key: 'KD_TIME_FORMAT',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.timeFormat = data
          const now = new Date()
          const hh = String(now.getHours()).padStart(2, '0')
          const mm = String(now.getMinutes()).padStart(2, '0')
          this.nowTime = this._fmtClock(hh + ':' + mm)
        }
      },
      fail: () => {
        if (!this.$valid) return
        this.timeFormat = '24h'
      }
    })
    // 键盘震动模式：从 app 全局缓存读取(app onCreate 已从 storage 读回并缓存)
    this.keyboardVibrateMode = this.$app.$def.getKeyboardVibrateMode()
  },

  adjustFontSize(delta) {
    let val = this.fontSizeValue + delta
    if (val < 20) val = 20
    if (val > 36) val = 36
    this.fontSizeValue = val
    storage.set({ key: 'KD_FONT_SIZE', value: val.toString() })
  },

  toggleKeepScreenOn() {
    this.keepScreenOn = !this.keepScreenOn
    storage.set({ key: 'KD_KEEP_SCREEN_ON', value: this.keepScreenOn.toString() })
    // brightness 暂不可用
  },

  toggleTimeFormat() {
    this.timeFormat = this.timeFormat === '24h' ? '12h' : '24h'
    storage.set({ key: 'KD_TIME_FORMAT', value: this.timeFormat })
    // 立即刷新时间显示
    const now = new Date()
    const hh = String(now.getHours()).padStart(2, '0')
    const mm = String(now.getMinutes()).padStart(2, '0')
    this.nowTime = this._fmtClock(hh + ':' + mm)
  },

  toggleKeyboardVibrate() {
    // 三态循环:''(关闭) → 'short'(短震) → 'long'(长震) → ''(关闭)
    if (this.keyboardVibrateMode === '') {
      this.keyboardVibrateMode = 'short'
    } else if (this.keyboardVibrateMode === 'short') {
      this.keyboardVibrateMode = 'long'
    } else {
      this.keyboardVibrateMode = ''
    }
    // 持久化到 app 全局缓存 + storage,聊天页 InputMethod 下次读取即生效
    this.$app.$def.setKeyboardVibrateMode(this.keyboardVibrateMode)
  },

  loadStorageInfo() {
    device.getAvailableStorage({
      success: (data) => {
        if (!this.$valid) return
        this.availableStorage = dataManager.formatFileSize(data.availableStorage || 0)
      },
      fail: () => {
        if (!this.$valid) return
        this.availableStorage = '获取失败'
      }
    })

    this.loadContentCount()

    dataManager.getContentStorageSize().then((size) => {
      if (!this.$valid) return
      this.contentStorageSize = dataManager.formatFileSize(size || 0)
    })

    this.loadTransferRecords()
  },

  loadContentCount() {
    try {
      const store = this.$app.$def && this.$app.$def.store
      if (store && store.getSubjects) {
        const subjects = store.getSubjects()
        let builtin = 0
        let total = 0
        for (let i = 0; i < subjects.length; i++) {
          const s = subjects[i]
          total += s.count
          if (!s.imported) {
            builtin += s.count
          }
        }
        this.builtinCount = builtin.toString()
        this.totalCount = total.toString()
      } else {
        this.builtinCount = '0'
        this.totalCount = '0'
      }
    } catch (e) {
      this.builtinCount = '0'
      this.totalCount = '0'
    }
  },

  loadTransferRecords() {
    storage.get({
      key: 'KD_TRANSFER_RECORDS',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          try {
            const list = JSON.parse(data)
            if (Array.isArray(list)) {
              // 按时间倒序排列，取前5条
              list.sort((a, b) => (b.time || 0) - (a.time || 0))
              this.transferRecords = list.slice(0, 5).map(item => ({
                id: item.id,
                name: item.name,
                time: this.formatTimestamp(item.time)
              }))
              return
            }
          } catch (e) {
            // 解析失败，忽略
          }
        }
        this.transferRecords = []
      },
      fail: () => {
        if (!this.$valid) return
        this.transferRecords = []
      }
    })
  },

  formatTimestamp(ts) {
    if (!ts) return ''
    const d = new Date(ts)
    const month = d.getMonth() + 1
    const day = d.getDate()
    let hours = d.getHours()
    let minutes = d.getMinutes()
    hours = hours < 10 ? '0' + hours : hours
    minutes = minutes < 10 ? '0' + minutes : minutes
    return month + '-' + day + ' ' + hours + ':' + minutes
  },

  clearCache() {
    // 清除内存缓存提示
    prompt.showToast({ message: '内存缓存已清理', duration: 1500 })
  },

  goDeleteAll() {
    router.push({
      uri: '/pages/deleteConfirm',
      params: { action: 'deleteAll' }
    })
  },

  goImport() {
    router.push({ uri: '/pages/import' })
  },

  goBack() {
    router.back()
  },

  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
</style>