<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- 空状态 -->
    <div if="{{allItems.length == 0}}" style="position: absolute; left: 0px; top: 102px; width: 336px; height: 240px; flex-direction: column; justify-content: center; align-items: center;">
      <img static src="/common/images/empty_state.png" style="width: 96px; height: 96px;" />
      <text static style="line-height: 36px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.4); text-align: center; margin-top: 16px;">没有文件</text>
    </div>

    <!-- 列表 -->
    <list class="list" id="homeList" if="{{allItems.length > 0}}">
      <list-item for="{{visibleItems}}" tid="id" class="item" type="folder" @click="onItemClick($item)" @longpress="onLongPress($item)" @touchstart="onTouchStart" @touchmove="onTouchMove">
        <div class="item-content">
          <text class="itemtext">{{$item.name}}</text>
          <text class="itemtext2">{{$item.subtitle}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
      <!-- 底部占位：防止悬浮按钮遮挡最后几条科目信息 -->
      <list-item type="footer" class="list-padding"></list-item>
    </list>

    <!-- 顶部栏 -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <!-- 顶部渐变遮罩（始终显示） -->
    <img static src="/common/images/top_mask.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="exitApp" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <img static src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text static style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">闪念小抄</text>

    <!-- 右下角全局搜索图标（闪念小抄样式） -->
    <img static src="/common/images/search.png" @click="goSearch" class="fab fab--search" />

    <!-- 左下角 AI 聊天图标（闪念小抄样式） -->
    <img static src="/common/images/chat.png" @click="goChat" class="fab fab--chat" />

  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'
import storage from '@system.storage'
import dataManager from '../../common/utils/dataManager.js'
import { onTimeChange, offTimeChange } from '../../common/clock.js'
import appState from '../../common/utils/appState.js'

export default {
  private: {
    nowTime: '00:00',
    __unsubClock: null,
    timeFormat: '24h',
    allItems: [],
    visibleItems: [],
    isNavigating: false,
    longPressTriggered: false,
    // 滑动误触防护
    touchStartX: 0,
    touchStartY: 0,
    touchMoved: false,
    _unsubReceive: null
  },

  onInit() {
    this.loadTimeFormat()
    this.__unsubClock = onTimeChange((t) => {
      if (this.$valid) {
        this.nowTime = this._fmtClock(t)
      }
    })

    // 订阅接收事件：用户数据加载/导入/删除后刷新列表
    if (this.$app.$def && this.$app.$def.onReceive) {
      this._unsubReceive = this.$app.$def.onReceive((evt) => {
        if (!this.$valid) return
        if (evt && (evt.kind === 'userdata-loaded' || evt.kind === 'userdata-changed' || evt.kind === 'imported')) {
          this.loadData()
        }
      })
    }
  },

  _fmtClock(t) {
    if (this.timeFormat === '12h') {
      const parts = t.split(':')
      let h = parseInt(parts[0], 10) || 0
      const m = parts[1] || '00'
      const ampm = h >= 12 ? '下午' : '上午'
      h = h % 12 || 12
      return ampm + ' ' + h + ':' + m
    }
    return t
  },

  loadTimeFormat() {
    storage.get({
      key: 'KD_TIME_FORMAT',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.timeFormat = data
        }
        // 重新格式化当前时间
        const now = new Date()
        const hh = String(now.getHours()).padStart(2, '0')
        const mm = String(now.getMinutes()).padStart(2, '0')
        this.nowTime = this._fmtClock(hh + ':' + mm)
      },
      fail: () => {
        if (!this.$valid) return
        const now = new Date()
        const hh = String(now.getHours()).padStart(2, '0')
        const mm = String(now.getMinutes()).padStart(2, '0')
        this.nowTime = this._fmtClock(hh + ':' + mm)
      }
    })
  },

  onShow() {
    this.isNavigating = false
    this.longPressTriggered = false
    if (appState.needRefreshList) {
      appState.needRefreshList = false
    }
    this.loadData()
  },

  onDestroy() {
    if (this.__unsubClock) {
      offTimeChange(this.__unsubClock)
      this.__unsubClock = null
    }
    if (this._unsubReceive) {
      this._unsubReceive()
      this._unsubReceive = null
    }
  },

  loadData() {
    const items = []

    // 1) 加载知识点科目（来自闪念小抄 knowledgeStore）
    try {
      const store = this.$app.$def && this.$app.$def.store
      if (store && store.getSubjects) {
        const subjects = store.getSubjects()
        if (subjects && subjects.length > 0) {
          for (let i = 0; i < subjects.length; i++) {
            const s = subjects[i]
            items.push({
              id: 'kd_' + i + '_' + s.name,
              name: s.name,
              subtitle: s.count + '个知识点',
              type: 'knowledge',
              knowledgeSubject: s.name,
              imported: s.imported
            })
          }
        }
      }
    } catch (e) {
      console.log('load knowledge subjects error: ' + e)
    }

    // 2) 加载考点阅读器的文件夹/文件（来自 dataManager）
    dataManager.getTopLevelFolders().then((folders) => {
      if (folders) {
        folders.forEach((folder) => {
          const subtitle = folder.type === 'folder' ? '文件夹' : '考点'
          items.push({
            id: folder.id,
            name: folder.name,
            subtitle: subtitle,
            type: folder.type || 'content',
            path: folder.id
          })
        })
      }
    }).catch((e) => {
      console.log('load folders error: ' + e)
    }).then(() => {
      if (!this.$valid) return
      this.allItems = items
      this.visibleItems = items
    })
  },

  onItemClick(item) {
    if (this.isNavigating) return
    if (this.longPressTriggered) {
      this.longPressTriggered = false
      return
    }
    // 滑动误触防护：手指移动超过阈值则不触发点击
    if (this.touchMoved) {
      this.touchMoved = false
      return
    }
    this.isNavigating = true

    if (item.type === 'knowledge') {
      // 知识点科目：导航到子文件夹页，以 knowledgeSubject 参数标识
      router.push({
        uri: '/pages/subfolder',
        params: { knowledgeSubject: item.knowledgeSubject }
      })
    } else if (item.type === 'folder') {
      router.push({
        uri: '/pages/subfolder',
        params: { path: item.id }
      })
    } else {
      router.push({
        uri: '/pages/reader',
        params: { path: item.id }
      })
    }
  },

  onLongPress(item) {
    if (this.isNavigating) return

    // 知识点科目：仅导入科目(imported=true)可长按删除，内置科目不可删
    if (item.type === 'knowledge') {
      if (!item.imported) return
      this.longPressTriggered = true
      this.isNavigating = true
      router.push({
        uri: '/pages/deleteConfirm',
        params: {
          action: 'deleteKnowledge',
          name: item.knowledgeSubject || item.name
        }
      })
      return
    }

    this.longPressTriggered = true
    this.isNavigating = true
    router.push({
      uri: '/pages/deleteConfirm',
      params: {
        action: item.type === 'folder' ? 'deleteFolder' : 'deleteContent',
        path: item.id,
        name: item.name
      }
    })
  },

  // 滑动误触防护：记录触摸起点
  onTouchStart(e) {
    const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
    if (t) {
      this.touchStartX = t.clientX
      this.touchStartY = t.clientY
      this.touchMoved = false
    }
  },

  // 滑动误触防护：手指移动超过 10px 判定为滑动，抑制后续 click
  onTouchMove(e) {
    const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
    if (t) {
      const dx = Math.abs(t.clientX - this.touchStartX)
      const dy = Math.abs(t.clientY - this.touchStartY)
      if (dx > 10 || dy > 10) {
        this.touchMoved = true
      }
    }
  },

  goSettings() {
    router.push({ uri: '/pages/globalSettings' })
  },

  goSearch() {
    router.push({ uri: '/pages/search', params: { scope: 'global' } })
  },

  goChat() {
    router.push({ uri: '/pages/chat' })
  },

  exitApp() {
    app.terminate()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      app.terminate()
    }
  },

  onBackPress() {
    app.terminate()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
  .list {
    height: 394px;
    top: 86px;
    padding: 0px 6px;
  }
  .list-padding {
    height: 90px;
    width: 100%;
  }
</style>
