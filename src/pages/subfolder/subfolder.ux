<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- 空状态：文件夹模式无项 或 知识点模式加载完仍无项 -->
    <div if="{{(!knowledgeSubject && allItems.length == 0) || (knowledgeSubject && ready && totalCount == 0)}}" style="position: absolute; width: 336px; height: 480px; flex-direction: column; justify-content: center; align-items: center;">
      <img static src="/common/images/empty_state.png" style="width: 128px; height: 128px;" />
      <text static style="line-height: 42px; font-weight: bold; font-size: 28px; color: rgba(255,255,255,0.6); text-align: center; margin-top: 24px;">没有文件</text>
    </div>

    <!-- 加载中占位（仅知识点模式，首屏分片加载未完成时显示） -->
    <div if="{{knowledgeSubject && !ready}}" style="position: absolute; width: 336px; height: 480px; flex-direction: column; justify-content: center; align-items: center;">
      <text static style="font-size: 24px; color: rgba(255,255,255,0.6);">加载中...</text>
    </div>

    <!-- 列表 -->
    <list class="list" if="{{visibleItems.length > 0}}" id="subList" @scrollbottom="loadMore">
      <list-item for="{{visibleItems}}" tid="id" class="item" type="item" @click="onItemClick($item)" @touchstart="onTouchStart($item)" @touchmove="onTouchMove" @touchend="onTouchEnd">
        <div class="item-content">
          <text class="itemtext">{{$item.name}}</text>
          <text class="itemtext2">{{$item.subtitle}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
      <!-- 触底加载指示：知识点模式且还有更多未加载 -->
      <list-item type="loading-more" class="loading-more" if="{{knowledgeSubject && visibleItems.length < totalCount}}">
        <text class="loading-more__text" static>正在加载...</text>
      </list-item>
    </list>

    <!-- 顶部栏（hd.png 自带渐变遮罩效果，同考点阅读页） -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <img static src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center; lines: 1; text-overflow: ellipsis;">{{pageName}}</text>

  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import dataManager from '../../common/utils/dataManager.js'
import { onTimeChange, offTimeChange } from '../../common/clock.js'

export default {
  private: {
    nowTime: '00:00',
    __unsubClock: null,
    timeFormat: '24h',
    pageName: '',
    allItems: [],
    visibleItems: [],
    isNavigating: false,
    longPressTriggered: false,
    // 滑动误触防护：记录触摸起点和是否滑动
    touchStartX: 0,
    touchStartY: 0,
    touchMoved: false,
    // 长按检测（非绑定字段，仅用于计时器引用）
    __longPressTimer: null,
    __longPressItem: null,
    // 知识点分片加载：ready 为首屏分片是否完成；totalCount 为全量条目数
    ready: true,
    totalCount: 0
  },
  protected: {
    path: '',
    knowledgeSubject: ''
  },

  onInit() {
    this.loadTimeFormat()
    this.__unsubClock = onTimeChange((t) => {
      if (this.$valid) {
        this.nowTime = this._fmtClock(t)
      }
    })

    if (this.knowledgeSubject) {
      // 知识点科目模式：从 knowledgeStore 加载知识点列表
      this.pageName = this.knowledgeSubject
    } else {
      this.pageName = dataManager.getNodeName(this.path) || '文件夹'
    }
  },

  _fmtClock(t) {
    if (this.timeFormat === '12h') {
      const parts = t.split(':')
      let h = parseInt(parts[0], 10) || 0
      const m = parts[1] || '00'
      const ampm = h >= 12 ? '下午' : '上午'
      h = h % 12 || 12
      return ampm + ' ' + h + ':' + m
    }
    return t
  },

  loadTimeFormat() {
    storage.get({
      key: 'KD_TIME_FORMAT',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.timeFormat = data
        }
        const now = new Date()
        const hh = String(now.getHours()).padStart(2, '0')
        const mm = String(now.getMinutes()).padStart(2, '0')
        this.nowTime = this._fmtClock(hh + ':' + mm)
      },
      fail: () => {
        if (!this.$valid) return
        const now = new Date()
        const hh = String(now.getHours()).padStart(2, '0')
        const mm = String(now.getMinutes()).padStart(2, '0')
        this.nowTime = this._fmtClock(hh + ':' + mm)
      }
    })
  },

  onShow() {
    this.isNavigating = false
    this.longPressTriggered = false
    this.loadData()
  },

  onDestroy() {
    if (this.__unsubClock) {
      offTimeChange(this.__unsubClock)
      this.__unsubClock = null
    }
    // 清理分片加载定时器，避免页面销毁后回调写入已失效实例
    if (this.__loadTimer) {
      clearTimeout(this.__loadTimer)
      this.__loadTimer = null
    }
  },

  loadData() {
    if (this.knowledgeSubject) {
      // 知识点模式：从 knowledgeStore 加载
      this.loadKnowledgePoints()
      return
    }

    // 文件夹模式：从 dataManager 加载
    dataManager.getVisibleChildren(this.path).then((children) => {
      if (!this.$valid) return
      this.allItems = children || []
      this.visibleItems = this.allItems
    })
  },

  loadKnowledgePoints() {
    // 清理上一次未完成的分片加载，避免 onShow 重入时 __loadingMore 残留导致新加载被跳过
    if (this.__loadTimer) {
      clearTimeout(this.__loadTimer)
      this.__loadTimer = null
    }
    this.__loadingMore = false
    try {
      const store = this.$app.$def && this.$app.$def.store
      let points = null
      if (store && store.getKnowledge) {
        points = store.getKnowledge(this.knowledgeSubject)
      }
      // 查询当前科目是否为导入科目（用于长按删除判定）
      var subjectImported = false
      try {
        var subjects = store.getSubjects()
        for (var si = 0; si < subjects.length; si++) {
          if (subjects[si].name === this.knowledgeSubject) {
            subjectImported = subjects[si].imported
            break
          }
        }
      } catch (e) {}

      if (points && points.length > 0) {
        // 全量数据存非绑定字段 __allList，避免几百条塞进数据观测系统造成卡顿
        this.__allList = points.map((p, i) => ({
          id: 'kp_' + i + '_' + (p.id || i),
          name: p.title || ('知识点' + (i + 1)),
          subtitle: (p.points && p.points.length > 0) ? (p.points.length + '个要点') : (p.desc || '知识点'),
          type: 'knowledge_point',
          knowledgeIndex: i,
          knowledgeSubject: this.knowledgeSubject,
          imported: subjectImported
        }))
        this.totalCount = this.__allList.length
        this.ready = false
        this.visibleItems = []
        // 分片异步交付首屏，避免一次渲染全部 list-item 卡顿
        this._loadMoreChunk()
      } else {
        this.__allList = []
        this.totalCount = 0
        this.ready = true
        this.visibleItems = []
      }
    } catch (e) {
      console.log('loadKnowledgePoints error: ' + e)
      this.__allList = []
      this.totalCount = 0
      this.ready = true
      this.visibleItems = []
    }
    if (!this.$valid) return
  },

  // 分片异步加载：每次最多追加 12 条，内部按 BATCH=6 分片，片间 setTimeout(0) 让出主线程渲染。
  // 初始首屏加载与 scrollbottom 触底加载共用此方法，__loadingMore 防重入。
  _loadMoreChunk() {
    if (this.__loadingMore) return
    if (this.visibleItems.length >= this.totalCount) {
      this.ready = true
      return
    }
    this.__loadingMore = true
    const BATCH = 6
    const target = Math.min(this.visibleItems.length + 12, this.totalCount)
    const tick = () => {
      if (!this.$valid) {
        this.__loadTimer = null
        this.__loadingMore = false
        return
      }
      const cur = this.visibleItems.length
      if (cur >= target) {
        this.__loadTimer = null
        this.__loadingMore = false
        this.ready = true
        return
      }
      const chunk = this.__allList.slice(cur, Math.min(cur + BATCH, target))
      this.visibleItems = this.visibleItems.concat(chunk)
      this.__loadTimer = setTimeout(tick, 0)
    }
    tick()
  },

  // scrollbottom 触底加载：委托给 _loadMoreChunk 统一分片异步交付
  loadMore() {
    this._loadMoreChunk()
  },

  onItemClick(item) {
    if (this.isNavigating) return
    if (this.longPressTriggered) {
      this.longPressTriggered = false
      return
    }
    // 滑动误触防护：手指移动超过阈值则不触发点击
    if (this.touchMoved) {
      this.touchMoved = false
      return
    }
    this.isNavigating = true

    // 知识点条目：导航到内容页
    if (item.type === 'knowledge_point') {
      router.push({
        uri: '/pages/content',
        params: {
          knowledgeSubject: item.knowledgeSubject,
          knowledgeIndex: item.knowledgeIndex
        }
      })
      return
    }

    // 蓝牙传输文件夹内容
    if (this.path && this.path.startsWith('bt_')) {
      if (item.type === 'folder') {
        router.push({ uri: '/pages/subfolder', params: { path: item.id } })
      } else {
        router.push({ uri: '/pages/reader', params: { path: item.id } })
      }
      return
    }

    // 内置示例
    if (this.path === 'builtin') {
      router.push({ uri: '/pages/reader', params: { path: item.id } })
      return
    }

    // 内置内容：用 path + index
    const index = this.allItems.indexOf(item)
    const childPath = this.path + ',' + index

    if (item.type === 'folder') {
      router.push({ uri: '/pages/subfolder', params: { path: childPath } })
    } else {
      router.push({ uri: '/pages/reader', params: { path: childPath } })
    }
  },

  goSettings() {
    router.push({ uri: '/pages/globalSettings' })
  },

  onLongPress(item) {
    if (this.isNavigating) return

    // 知识点条目：若所属科目为导入科目(imported=true)，长按可删除整科
    if (item.type === 'knowledge_point') {
      if (!item.imported) return
      this.longPressTriggered = true
      this.isNavigating = true
      router.push({
        uri: '/pages/deleteConfirm',
        params: {
          action: 'deleteKnowledge',
          name: this.knowledgeSubject
        }
      })
      return
    }

    if (this.path === 'builtin') return

    this.longPressTriggered = true
    this.isNavigating = true

    if (this.path && this.path.startsWith('bt_')) {
      router.push({
        uri: '/pages/deleteConfirm',
        params: {
          action: item.type === 'folder' ? 'deleteFolder' : 'deleteContent',
          path: item.id,
          name: item.name
        }
      })
      return
    }

    const index = this.allItems.indexOf(item)
    const childPath = this.path + ',' + index
    router.push({
      uri: '/pages/deleteConfirm',
      params: {
        action: item.type === 'folder' ? 'deleteFolder' : 'deleteContent',
        path: childPath,
        name: item.name
      }
    })
  },

  // 滑动误触防护 + 长按检测：记录触摸起点，启动长按计时器
  onTouchStart(item) {
    this.touchStartX = 0
    this.touchStartY = 0
    this.touchMoved = false
    // 存储当前触摸项，启动长按计时器
    this.__longPressItem = item
    if (this.__longPressTimer) {
      clearTimeout(this.__longPressTimer)
    }
    this.__longPressTimer = setTimeout(() => {
      this.__longPressTimer = null
      if (this.__longPressItem && !this.touchMoved && !this.isNavigating) {
        this.onLongPress(this.__longPressItem)
      }
      this.__longPressItem = null
    }, 500)
  },

  // 滑动误触防护 + 长按取消：手指移动判定为滑动，取消长按
  onTouchMove() {
    this.touchMoved = true
    // 手指移动时取消长按
    if (this.__longPressTimer) {
      clearTimeout(this.__longPressTimer)
      this.__longPressTimer = null
      this.__longPressItem = null
    }
  },

  // 手指抬起：取消长按计时器（未到 500ms 即抬起不算长按）
  onTouchEnd() {
    if (this.__longPressTimer) {
      clearTimeout(this.__longPressTimer)
      this.__longPressTimer = null
      this.__longPressItem = null
    }
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      router.back()
    }
  },

  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
  .list {
    height: 394px;
    top: 86px;
    padding: 0px 6px;
  }
  /* 触底加载指示：list-item 需显式宽高以满足组件复用要求 */
  .loading-more {
    height: 60px;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }
  .loading-more__text {
    color: rgba(255,255,255,0.6);
    font-size: 22px;
  }
</style>
