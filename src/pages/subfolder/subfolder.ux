<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- 空状态 -->
    <div if="{{(!knowledgeSubject && allItems.length == 0) || (knowledgeSubject && ready && totalCount == 0)}}" style="position: absolute; width: 336px; height: 480px; flex-direction: column; justify-content: center; align-items: center;">
      <img static src="/common/images/empty_state.png" style="width: 128px; height: 128px;" />
      <text static style="line-height: 42px; font-weight: bold; font-size: 28px; color: rgba(255,255,255,0.6); text-align: center; margin-top: 24px;">没有文件</text>
    </div>

    <!-- 加载中占位（仅知识点模式） -->
    <div if="{{knowledgeSubject && !ready}}" style="position: absolute; width: 336px; height: 480px; flex-direction: column; justify-content: center; align-items: center;">
      <text static style="font-size: 24px; color: rgba(255,255,255,0.6);">加载中...</text>
    </div>

    <!-- 文件夹/考点列表 -->
    <list class="list" if="{{visibleItems.length > 0}}" id="subList" @scrollbottom="loadMore">
      <list-item for="{{visibleItems}}" tid="id" class="item" type="item"
        @click="onItemClick($item)">
        <div class="swipe-wrap" 
          @touchstart="onItemTouchStart($item, $event)"
          @touchmove="onItemTouchMove($item, $event)"
          @touchend="onItemTouchEnd($event)">
          <div class="swipe-content" style="margin-left: {{swipedId === $item.id ? '-100px' : '0px'}};">
            <div class="item-main">
              <div class="item-content">
                <text class="itemtext">{{$item.name}}</text>
                <text class="itemtext2">{{$item.subtitle}}</text>
              </div>
              <img static src="/common/images/enter.png" class="arrow" />
            </div>
            <div class="swipe-delete" @click="onDeleteClick($item)">
              <text class="swipe-delete-text">删除</text>
            </div>
          </div>
        </div>
      </list-item>
      <!-- 触底加载指示 -->
      <list-item type="loading-more" class="loading-more" if="{{knowledgeSubject && visibleItems.length < totalCount}}">
        <text class="loading-more__text" static>正在加载...</text>
      </list-item>
    </list>

    <!-- 遮罩层 -->
    <img static src="/common/images/mask_up.png" style="position: absolute; top: 0; left: 0; width: 336px; height: 86px;" />
    <!-- 顶部按钮（在遮罩之上，保持可点击） -->
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <img static src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center; lines: 1; text-overflow: ellipsis;">{{pageName}}</text>

  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import dataManager from '../../common/utils/dataManager.js'
import { onTimeChange, offTimeChange } from '../../common/clock.js'

export default {
  private: {
    nowTime: '00:00',
    __unsubClock: null,
    timeFormat: '24h',
    pageName: '',
    allItems: [],
    visibleItems: [],
    isNavigating: false,
    swipedId: '',
    // 知识点分片加载
    ready: true,
    totalCount: 0
  },
  protected: {
    path: '',
    knowledgeSubject: ''
  },

  onInit() {
    this.loadTimeFormat()
    this.__unsubClock = onTimeChange((t) => {
      if (this.$valid) {
        this.nowTime = this._fmtClock(t)
      }
    })

    if (this.knowledgeSubject) {
      this.pageName = this.knowledgeSubject
    } else {
      this.pageName = dataManager.getNodeName(this.path) || '文件夹'
    }
  },

  _fmtClock(t) {
    if (this.timeFormat === '12h') {
      var parts = t.split(':')
      var h = parseInt(parts[0], 10) || 0
      var m = parts[1] || '00'
      var ampm = h >= 12 ? '下午' : '上午'
      h = h % 12 || 12
      return ampm + ' ' + h + ':' + m
    }
    return t
  },

  loadTimeFormat() {
    storage.get({
      key: 'KD_TIME_FORMAT',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.timeFormat = data
        }
        var now = new Date()
        var hh = String(now.getHours()).padStart(2, '0')
        var mm = String(now.getMinutes()).padStart(2, '0')
        this.nowTime = this._fmtClock(hh + ':' + mm)
      },
      fail: () => {
        if (!this.$valid) return
        var now = new Date()
        var hh = String(now.getHours()).padStart(2, '0')
        var mm = String(now.getMinutes()).padStart(2, '0')
        this.nowTime = this._fmtClock(hh + ':' + mm)
      }
    })
  },

  onShow() {
    this.isNavigating = false
    this.swipedId = ''
    this.loadData()
  },

  onDestroy() {
    if (this.__unsubClock) {
      offTimeChange(this.__unsubClock)
      this.__unsubClock = null
    }
    if (this.__loadTimer) {
      clearTimeout(this.__loadTimer)
      this.__loadTimer = null
    }
  },

  loadData() {
    if (this.knowledgeSubject) {
      this.loadKnowledgePoints()
      return
    }

    // 文件夹模式
    dataManager.getVisibleChildren(this.path).then((children) => {
      if (!this.$valid) return
      this.allItems = children || []
      this.visibleItems = this.allItems
    })
  },

  loadKnowledgePoints() {
    if (this.__loadTimer) {
      clearTimeout(this.__loadTimer)
      this.__loadTimer = null
    }
    this.__loadingMore = false
    try {
      var store = this.$app.$def && this.$app.$def.store
      var points = null
      if (store && store.getKnowledge) {
        points = store.getKnowledge(this.knowledgeSubject)
      }
      var subjectImported = false
      try {
        var subjects = store.getSubjects()
        for (var si = 0; si < subjects.length; si++) {
          if (subjects[si].name === this.knowledgeSubject) {
            subjectImported = subjects[si].imported
            break
          }
        }
      } catch (e) {}

      if (points && points.length > 0) {
        var that = this
        this.__allList = points.map(function(p, i) {
          return {
            id: 'kp_' + i + '_' + (p.id || i),
            name: p.title || ('知识点' + (i + 1)),
            subtitle: (p.points && p.points.length > 0) ? (p.points.length + '个要点') : (p.desc || '知识点'),
            type: 'knowledge_point',
            knowledgeIndex: i,
            knowledgeSubject: that.knowledgeSubject,
            imported: subjectImported
          }
        })
        this.totalCount = this.__allList.length
        this.ready = false
        this.visibleItems = []
        this._loadMoreChunk()
      } else {
        this.__allList = []
        this.totalCount = 0
        this.ready = true
        this.visibleItems = []
      }
    } catch (e) {
      console.log('loadKnowledgePoints error: ' + e)
      this.__allList = []
      this.totalCount = 0
      this.ready = true
      this.visibleItems = []
    }
    if (!this.$valid) return
  },

  _loadMoreChunk() {
    if (this.__loadingMore) return
    if (this.visibleItems.length >= this.totalCount) {
      this.ready = true
      return
    }
    this.__loadingMore = true
    var BATCH = 6
    var target = Math.min(this.visibleItems.length + 12, this.totalCount)
    var that = this
    var tick = function() {
      if (!that.$valid) {
        that.__loadTimer = null
        that.__loadingMore = false
        return
      }
      var cur = that.visibleItems.length
      if (cur >= target) {
        that.__loadTimer = null
        that.__loadingMore = false
        that.ready = true
        return
      }
      var chunk = that.__allList.slice(cur, Math.min(cur + BATCH, target))
      that.visibleItems = that.visibleItems.concat(chunk)
      that.__loadTimer = setTimeout(tick, 0)
    }
    tick()
  },

  loadMore() {
    this._loadMoreChunk()
  },

  // === 纯touch事件左滑检测 ===
  onItemTouchStart(item, e) {
    if (!item) return
    this._touchItem = item
    this._touchMoved = false
    this._touchSwiped = false
    if (e && e.touches && e.touches[0]) {
      this._touchStartX = e.touches[0].clientX
    } else {
      this._touchStartX = 0
    }
  },

  onItemTouchMove(item, e) {
    if (!e || !e.touches || !e.touches[0] || !this._touchItem) return
    var dx = e.touches[0].clientX - this._touchStartX
    this._touchMoved = true

    // 左滑超过50px判定为左滑
    if (dx < -50) {
      this._touchSwiped = true
      // 知识点条目：仅导入科目可删除
      if (item.type === 'knowledge_point' && !item.imported) return
      // 内置示例不可删除
      if (this.path === 'builtin') return
      this.swipedId = item.id
    }
  },

  onItemTouchEnd(e) {
    if (!this._touchSwiped && !this._touchMoved && this._touchItem) {
      // 没有滑动，视为点击
      this.onItemClick(this._touchItem)
    }
    this._touchItem = null
    this._touchMoved = false
    this._touchSwiped = false
  },

  // 点击列表项
  onItemClick(item) {
    if (this.isNavigating) return
    if (!item) return

    // 如果当前项已展开删除按钮，点击则收起
    if (this.swipedId === item.id) {
      this.swipedId = ''
      return
    }
    // 如果有其他项展开了删除按钮，先收起
    if (this.swipedId) {
      this.swipedId = ''
      return
    }

    this.isNavigating = true

    // 知识点条目：导航到内容页
    if (item.type === 'knowledge_point') {
      router.push({
        uri: '/pages/content',
        params: {
          knowledgeSubject: item.knowledgeSubject,
          knowledgeIndex: item.knowledgeIndex
        }
      })
      return
    }

    // 蓝牙传输文件夹内容
    if (this.path && this.path.startsWith('bt_')) {
      if (item.type === 'folder') {
        router.push({ uri: '/pages/subfolder', params: { path: item.id } })
      } else {
        router.push({ uri: '/pages/reader', params: { path: item.id } })
      }
      return
    }

    // 内置示例
    if (this.path === 'builtin') {
      router.push({ uri: '/pages/reader', params: { path: item.id } })
      return
    }

    // 内置内容：用 path + index
    var index = this.allItems.indexOf(item)
    var childPath = this.path + ',' + index

    if (item.type === 'folder') {
      router.push({ uri: '/pages/subfolder', params: { path: childPath } })
    } else {
      router.push({ uri: '/pages/reader', params: { path: childPath } })
    }
  },

  // 点击删除按钮 → 跳转删除确认页
  onDeleteClick(item) {
    if (!item) return
    this.swipedId = ''
    this.isNavigating = true

    // 知识点科目删除
    if (item.type === 'knowledge_point') {
      router.push({
        uri: '/pages/deleteConfirm',
        params: {
          action: 'deleteKnowledge',
          name: this.knowledgeSubject
        }
      })
      return
    }

    // 蓝牙传输文件夹内容
    if (this.path && this.path.startsWith('bt_')) {
      router.push({
        uri: '/pages/deleteConfirm',
        params: {
          action: item.type === 'folder' ? 'deleteFolder' : 'deleteContent',
          path: item.id,
          name: item.name
        }
      })
      return
    }

    // 内置内容
    var index = this.allItems.indexOf(item)
    var childPath = this.path + ',' + index
    router.push({
      uri: '/pages/deleteConfirm',
      params: {
        action: item.type === 'folder' ? 'deleteFolder' : 'deleteContent',
        path: childPath,
        name: item.name
      }
    })
  },

  goSettings() {
    router.push({ uri: '/pages/globalSettings' })
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      // 如果有删除按钮展开，右滑先收起
      if (this.swipedId) {
        this.swipedId = ''
        return
      }
      router.back()
    }
  },

  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
  .list {
    height: 394px;
    top: 86px;
    padding: 0px 6px;
  }
  .list-padding {
    height: 90px;
    width: 100%;
  }
  /* 触底加载指示 */
  .loading-more {
    height: 60px;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }
  .loading-more__text {
    color: rgba(255,255,255,0.6);
    font-size: 22px;
  }
</style>